        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <!--change to ms auto to mvoe to right side-->
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <% if(title=="Home"){%>
              <a class="nav-link active" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home</a>
              <% } else { %>
              <a class="nav-link" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home</a>
              <% } %>
            </li>
